%  DEFINE FUNCTIONS

% main 
function func(I)
    disp('Main function called.');
    checkType(I);
    
end

% deine type of image
function checkType(I)
    dims = length(size(I));
    disp(dims);

    % if it's 2D image
   
    % if it's  3D image 
    elseif dims == 3
        if size(I, 3) == 3
            disp('Is RGB image');
        else
            disp('3D image but not RGB');
        end
    else
        disp('The image has unexpected dimensions.');
    end
end