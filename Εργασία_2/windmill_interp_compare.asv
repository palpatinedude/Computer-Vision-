%% Compare interpolation methods to see how they affect the rotated blades’ appearance
clear; close all; clc;

addpath('transformations');

%% Load images
bg = imread('CV_2-TRANSFORMATIONS/windmill_back.jpeg');
blades = imread('CV_2-TRANSFORMATIONS/windmill.png');
mask = imread('CV_2-TRANSFORMATIONS/windmill_mask.png');

[H_bg, W_bg, ~] = size(bg);
[H_b, W_b, ~] = size(blades);

numFrames = 60;
rotationPerFrame = 360/numFrames;
posX = round(W_bg/2 - W_b/2) + 17;
posY = round(H_bg/2 - H_b/2) - 27;
bgPatch = bg(posY+1:posY+H_b, posX+1:posX+W_b, :);

interpMethods = {'nearest','linear','cubic'};

for m = 1:length(interpMethods)
    method = interpMethods{m};
    videoFrames = zeros(H_bg, W_bg, 3, numFrames, 'uint8');
    
    for k = 1:numFrames
        angle = rotationPerFrame * (k-1);
        
        % Rotate blades using imwarp with affine transform
        tform = affine2d([cosd(angle) -sind(angle) 0; sind(angle) cosd(angle) 0; 0 0 1]);
        rotatedBlades = imwarp(blades, tform, 'OutputView', imref2d(size(blades)), ...
                               'InterpolationMethod', method);
        rotatedMask = imwarp(mask, tform, 'OutputView', imref2d(size(mask)), ...
                             'InterpolationMethod', method);
        
        % Replace black pixels with background to remove dark edges
        blackPixels = all(rotatedBlades == 0, 3);
        for c = 1:3
            rotatedBlades(:,:,c) = rotatedBlades(:,:,c).*uint8(~blackPixels) + ...
                                   bgPatch(:,:,c).*uint8(blackPixels);
        end
        
        % Frame copy of background
        frame = bg;
        roiX = posX+1:posX+W_b;
        roiY = posY+1:posY+H_b;
        roiX = roiX(roiX<=W_bg);
        roiY = roiY(roiY<=H_bg);
        
        % Apply mask: only replace pixels where mask == 0 (blades)
        for c = 1:3
            tempBg = frame(roiY, roiX, c);
            tempMask = rotatedMask(1:length(roiY),1:length(roiX)) == 0;
            tempBladeSlice = rotatedBlades(1:length(roiY),1:length(roiX),c);
            tempBg(tempMask) = tempBladeSlice(tempMask);
            frame(roiY,roiX,c) = tempBg;
        end
        
        videoFrames(:,:,:,k) = frame;
    end
    
    % Save video
    v = VideoWriter(['transf_windmill_' method '.avi']);
    open(v); writeVideo(v, videoFrames); close(v);

end
