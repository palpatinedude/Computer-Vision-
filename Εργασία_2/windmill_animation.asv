%{
% Windmill animation with mask
clear; close all; 

addpath('transformations');

%% Load images
bg = imread('CV_2-TRANSFORMATIONS/windmill_back.jpeg');   % background
blades = imread('CV_2-TRANSFORMATIONS/windmill.png');     % windmill blades
mask = imread('CV_2-TRANSFORMATIONS/windmill_mask.png');  % mask of blades

[H_bg, W_bg, ~] = size(bg);
[H_b, W_b, ~] = size(blades);

% Parameters
numFrames = 60;                 % number of frames
rotationPerFrame = 360/numFrames; % degrees per frame
videoFrames = zeros(H_bg, W_bg, 3, numFrames, 'uint8');

% Position to place windmill (centered)
posX = round(W_bg/2 - W_b/2);
posY = round(H_bg/2 - H_b/2) - 50;

% Optionally scale blades (using scaleImage)
params.scaleFactor = 1;  % 1 = original size
blades = scaleImage(blades, params);

% Create animation
for k = 1:numFrames
    % Rotation angle for this frame
    params.angle = rotationPerFrame * (k-1);
    
    % Rotate blades using rotateImage function
    rotatedBlades = rotateImage(blades, params);
    
    % Rotate mask the same way
    rotatedMask = rotateImage(mask, params);
    
    % Create frame copy of background
    frame = bg;
    
    % Define region of interest (ROI) on the background
    roiX = posX+1 : posX + size(rotatedBlades,2);
    roiY = posY+1 : posY + size(rotatedBlades,1);
    
    % Ensure ROI fits in background
    roiX = roiX(roiX <= W_bg);
    roiY = roiY(roiY <= H_bg);
    
    % Apply mask: only replace where mask > 0
    for c = 1:3
        tempBg = frame(roiY, roiX, c);
        tempBlades = rotatedBlades(1:length(roiY), 1:length(roiX), c);
        tempMask = rotatedMask(1:length(roiY), 1:length(roiX)) == 0;  % only blades
        tempBg(tempMask) = tempBlades(tempMask);
        frame(roiY, roiX, c) = tempBg;
    end
    
    % Save frame in videoFrames
    videoFrames(:, :, :, k) = frame;
end


implay(videoFrames);

% Save video
v = VideoWriter('transf_windmill.avi');
open(v);
writeVideo(v, videoFrames);
close(v);
%}


%{
%% Windmill animation with mask (fixed base)
clear; close all; clc;

addpath('transformations');  % adjust if needed

%% Load images
bg = imread('CV_2-TRANSFORMATIONS/windmill_back.jpeg');   % background
blades = imread('CV_2-TRANSFORMATIONS/windmill.png');     % windmill blades
mask = imread('CV_2-TRANSFORMATIONS/windmill_mask.png');  % mask of blades

[H_bg, W_bg, ~] = size(bg);
[H_b, W_b, ~] = size(blades);

%% Parameters
numFrames = 60;                  
rotationPerFrame = 360/numFrames; 
videoFrames = zeros(H_bg, W_bg, 3, numFrames, 'uint8');

% Position to place windmill (bottom center fixed)
posX = round(W_bg/2 - W_b/2);
posY = round(H_bg/2 - H_b/2);  % adjust to fix base

%% Optionally scale blades
params.scaleFactor = 1;  
blades = scaleImage(blades, params);
mask = scaleImage(mask, params);

%% Create animation
for k = 1:numFrames
    angle = rotationPerFrame * (k-1);
    
    % Rotate blades and mask using 'crop' to keep size
    rotatedBlades = imrotate(blades, angle, 'bilinear', 'crop');
    rotatedMask = imrotate(mask, angle, 'nearest', 'crop');
    
    % Frame copy of background
    frame = bg;
    
    % Define ROI
    roiX = posX+1 : posX+W_b;
    roiY = posY+1 : posY+H_b;
    
    % Ensure ROI fits in background
    roiX = roiX(roiX <= W_bg);
    roiY = roiY(roiY <= H_bg);
    
    % Apply mask: only replace blades pixels
    for c = 1:3
        tempBg = frame(roiY, roiX, c);
        tempBlades = rotatedBlades(1:length(roiY), 1:length(roiX), c);
        tempMask = rotatedMask(1:length(roiY), 1:length(roiX)) > 0;
        tempBg(tempMask) = tempBlades(tempMask);
        frame(roiY, roiX, c) = tempBg;
    end
    
    % Save frame
    videoFrames(:,:,:,k) = frame;
end

%% Play video
implay(videoFrames);

%% Save video
v = VideoWriter('transf_windmill_fixed_base.avi');
open(v);
writeVideo(v, videoFrames);
close(v);

disp('Video saved as transf_windmill_fixed_base.avi');
%}


%% Windmill animation with mask with fixed base
clear; close all; clc;

addpath('transformations'); 

%% Load images
bg = imread('CV_2-TRANSFORMATIONS/windmill_back.jpeg');   % background
blades = imread('CV_2-TRANSFORMATIONS/windmill.png');     % windmill blades
mask = imread('CV_2-TRANSFORMATIONS/windmill_mask.png');  % mask of blades (black = blades, white = background)

[H_bg, W_bg, ~] = size(bg);
[H_b, W_b, ~] = size(blades);

% Parameters
numFrames = 60;                  
rotationPerFrame = 360/numFrames; 
videoFrames = zeros(H_bg, W_bg, 3, numFrames, 'uint8');

% Position to place windmill (bottom center fixed)
posX = round(W_bg/2 - W_b/2);
posY = round(H_bg/2 - H_b/2) - 20; 


% Create animation
for k = 1:numFrames
    angle = rotationPerFrame * (k-1);
    
    % Rotate blades and mask using 'crop' to keep size
    rotatedBlades = imrotate(blades, angle, 'bilinear', 'crop');
    rotatedMask = imrotate(mask, angle, 'nearest', 'crop');
    
    % Replace black background of blades with corresponding pixels from bg
    roiX = posX+1 : posX+W_b;
    roiY = posY+1 : posY+H_b;
    
    % Ensure ROI fits in background
    roiX = roiX(roiX <= W_bg);
    roiY = roiY(roiY <= H_bg);
    
    for c = 1:3
        blackPixels = rotatedBlades(:,:,c) == 0;  % pixels that are black in blades
        % Replace black pixels with background
        rotatedBlades(1:length(roiY), 1:length(roiX), c) = ...
            rotatedBlades(1:length(roiY), 1:length(roiX), c) .* uint8(~blackPixels(1:length(roiY),1:length(roiX))) + ...
            bg(roiY, roiX, c) .* uint8(blackPixels(1:length(roiY),1:length(roiX)));
    end
    
    % Frame copy of background
    frame = bg;
    
    % Apply mask: only replace pixels where mask == 0 (blades)
    for c = 1:3
        tempBg = frame(roiY, roiX, c);
        tempBlades = rotatedBlades(1:length(roiY), 1:length(roiX), c);
        tempMask = rotatedMask(1:length(roiY), 1:length(roiX)) == 0;  % black pixels = blades
        tempBg(tempMask) = tempBlades(tempMask);
        frame(roiY, roiX, c) = tempBg;
    end
    
    % Save frame
    videoFrames(:,:,:,k) = frame;
end


implay(videoFrames);

v = VideoWriter('transf_windmill_fixed_base.avi');
open(v);
writeVideo(v, videoFrames);
close(v);


