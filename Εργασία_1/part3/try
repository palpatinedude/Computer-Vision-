# Utility Functions

# Load the PSPNet model with pretrained weights to make inference on validation images
def load_model(model_path, device, num_classes=35):

    # Initialize PSPNet architecture
    model = PSPNet(
    layers=50, # Basic network that extracts features
    bins=(2,3,6,8),  # SPP - bins determine how many "boxes" the feature map is divided into at each level of the pyramid.
    dropout=0.1, # Randomly “turns off” 10% of neurons during training
    classes=35,  # Model predicts 35 different categories
    zoom_factor=8, # Enlargement of output features because the initial feature map from the backbone is smaller than the input
    use_ppm=True # Using SPP
    )

    # Loading trained weights
    model.load_state_dict(torch.load(computer_vision_root + 'codes_and_models/train_epoch_200_CPU.pth', map_location=device))
    model.to(device) # Model transfer to GPU
    model.eval()  # Model in evaluation mode

    return model


# Compute IoU for each class
def iou_per_class(pred, target, num_classes=35):

    ious = []
    # Flatten tensors to compute IoU
    pred = pred.view(-1)
    target = target.view(-1)

    # Compute IoU per class
    for cls in range(num_classes):
        pred_inds = pred == cls       # pixels predicted as class cls
        target_inds = target == cls   # pixels labeled as class cls
        intersection = (pred_inds & target_inds).sum().item()
        union = (pred_inds | target_inds).sum().item()
        ious.append(float('nan') if union == 0 else intersection / union)

    return np.array(ious)


# Convert a class mask to a color RGB image
def decode_segmap(mask, colors):

    h, w = mask.shape
    rgb = np.zeros((h, w, 3), dtype=np.uint8)

    # Assign each class its color
    for cls in range(len(colors)):
        rgb[mask == cls] = colors[cls]

    return rgb

# Visualize input images, ground truth masks, and predicted masks
def visualize_predictions(dataset, model, colors, device, n=5):

    for i in range(n):
        img, mask = dataset[i]                        # get image and mask
        img_tensor = img.unsqueeze(0).to(device)      # add batch dimension
        pred = torch.argmax(model(img_tensor)[0], dim=1).cpu().numpy()[0]  # predict mask

        # Display image, ground truth, and prediction
        plt.figure(figsize=(15,5))
        plt.subplot(1,3,1)
        plt.title("Image")
        plt.imshow(img.permute(1,2,0))  # convert CHW to HWC

        plt.subplot(1,3,2)
        plt.title("Ground Truth")
        plt.imshow(decode_segmap(mask.numpy(), colors))

        plt.subplot(1,3,3)
        plt.title("Prediction")
        plt.imshow(decode_segmap(pred, colors))
        plt.show()


# Evaluate model on a dataset using IoU metrics
def evaluate_model(model, dataloader, num_classes=35):

    all_ious = []

    # Disable gradient computation for evaluation
    with torch.no_grad():
        for img, mask in dataloader:

            # Move data to device
            img, mask = img.to(next(model.parameters()).device), mask.to(next(model.parameters()).device)

            # Forward pass (logits only)
            output = model(img)

            # Get predicted class per pixel
            pred = torch.argmax(output, dim=1)

            # Compute IoU per class
            ious = iou_per_class(pred, mask, num_classes)
            all_ious.append(ious)

    # Convert to numpy array for statistics
    all_ious = np.array(all_ious)
    stats = {
        "mean_iou_per_class": np.nanmean(all_ious, axis=0),
        "var_iou_per_class": np.nanvar(all_ious, axis=0),
        "mean_iou_per_image": np.nanmean(all_ious, axis=1).mean(),
        "var_iou_per_image": np.nanvar(all_ious, axis=1).mean()
    }

    return stats
